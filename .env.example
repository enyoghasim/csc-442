DATABASE_URL=postgres://postgres:postgres@localhost:5432/attendance_tracker
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=604800
# Cookie-signing key for express-session (HMAC, prevents tampering) — NOT a JWT secret, there is
# still no JWT anywhere in this project. Change for anything beyond local dev.
SESSION_SECRET=dev-secret-change-me
BACKEND_PORT=3001
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
ALLOWED_ORIGINS=https://www.trackx.geezy.dev,https://trackx.geezy.dev
